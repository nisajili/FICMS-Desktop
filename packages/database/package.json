{
  "name": "@ficms/database",
  "version": "0.1.0",
  "private": true,
  "description": "FICMS repository abstraction over pluggable SQL engines (SQLite/WASM + PostgreSQL)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "migrate": "tsx src/migrate/cli.ts migrate",
    "migrate:status": "tsx src/migrate/cli.ts status",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ficms/domain": "workspace:*",
    "@ficms/security": "workspace:*",
    "@ficms/types": "workspace:*",
    "sql.js": "^1.12.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@ficms/tsconfig": "workspace:*",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/sql.js": "^1.4.9",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
