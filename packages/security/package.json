{
  "name": "@ficms/security",
  "version": "0.1.0",
  "private": true,
  "description": "FICMS security primitives: password hashing, TOTP, tokens, field encryption",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ficms/types": "workspace:*",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@ficms/tsconfig": "workspace:*",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
