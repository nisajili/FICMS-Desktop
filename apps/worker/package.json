{
  "name": "@ficms/worker",
  "version": "0.1.0",
  "private": true,
  "description": "FICMS background worker (maintenance + BullMQ jobs with in-process fallback)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ficms/config": "workspace:*",
    "@ficms/database": "workspace:*",
    "@ficms/security": "workspace:*",
    "@ficms/types": "workspace:*",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@ficms/eslint-config": "workspace:*",
    "@ficms/tsconfig": "workspace:*",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
