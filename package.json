{
  "name": "ficms",
  "version": "0.1.0",
  "private": true,
  "description": "FICMS — Fertility & IVF Clinic Management System (cross-platform desktop)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @ficms/desktop dev",
    "dev:desktop": "pnpm --filter @ficms/desktop dev",
    "dev:api": "pnpm --filter @ficms/api start:dev",
    "dev:worker": "pnpm --filter @ficms/worker dev",
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' build",
    "build:desktop": "pnpm --filter @ficms/desktop build",
    "build:api": "pnpm --filter @ficms/api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ficms/api test:e2e",
    "dist:win": "pnpm --filter @ficms/desktop dist:win",
    "dist:mac": "pnpm --filter @ficms/desktop dist:mac",
    "dist:linux": "pnpm --filter @ficms/desktop dist:linux",
    "dist:all": "pnpm --filter @ficms/desktop dist:all",
    "db:migrate": "pnpm --filter @ficms/database migrate",
    "db:migrate:status": "pnpm --filter @ficms/database migrate:status",
    "db:seed": "pnpm --filter @ficms/database seed",
    "backup": "pnpm --filter @ficms/api backup",
    "restore": "pnpm --filter @ficms/api restore",
    "checksums": "node scripts/gen-checksums.mjs",
    "sbom": "node scripts/gen-sbom.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "clean": "pnpm -r exec -- rm -rf dist build .turbo node_modules/.cache && rm -rf node_modules/.cache"
  },
  "devDependencies": {
    "@ficms/eslint-config": "workspace:*",
    "@ficms/tsconfig": "workspace:*",
    "typescript": "^5.6.3"
  }
}
